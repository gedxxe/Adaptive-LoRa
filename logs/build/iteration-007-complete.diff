diff --git a/iteration-007-review-snapshot/test/support/fake_radio_transport.h b/iteration-007-review-snapshot/test/support/fake_radio_transport.h
new file mode 100644
index 0000000..a713e26
--- /dev/null
+++ b/iteration-007-review-snapshot/test/support/fake_radio_transport.h
@@ -0,0 +1,81 @@
+#pragma once
+#include <cstring>
+#include "common/radio/radio_transport.h"
+
+namespace adaptive_lora::test {
+struct CapturedPacket {
+    size_t length = 0;
+    uint8_t bytes[kMaxFrameSize]{};
+};
+
+// One operation and one captured packet per endpoint. Delivery is explicit:
+// packets cannot queue through half-duplex TX or reach a receiver that is off.
+class FakeRadioTransport final : public RadioTransport {
+public:
+    enum class Mode { IDLE, RX, TX, FAULT };
+    Mode mode = Mode::IDLE;
+    bool ready = true;  // Apps are constructed only after successful real begin.
+    unsigned rxFailuresLeft = 0;
+    bool failNextTx = false;
+    unsigned rxCalls = 0;
+    unsigned txCalls = 0;
+    unsigned successfulTxStarts = 0;
+    unsigned dropped = 0;
+    unsigned contractViolations = 0;
+    CapturedPacket lastTx;
+
+    int16_t receive() override {
+        ++rxCalls;
+        if (transmitting()) { ++contractViolations; return -901; }
+        if (!ready || rxFailuresLeft) {
+            if (rxFailuresLeft) --rxFailuresLeft;
+            mode = Mode::FAULT;
+            return -902;
+        }
+        mode = Mode::RX;
+        return 0;
+    }
+    int16_t transmit(const uint8_t* bytes, size_t length, uint32_t) override {
+        ++txCalls;
+        if (!bytes || length < kHeaderSize || length > kMaxFrameSize || transmitting() || !healthy()) {
+            ++contractViolations;
+            return -903;
+        }
+        lastTx.length = length;
+        std::memcpy(lastTx.bytes, bytes, length);
+        if (failNextTx) { failNextTx = false; mode = Mode::FAULT; return -904; }
+        ++successfulTxStarts;
+        mode = Mode::TX;
+        return 0;
+    }
+    bool transmitting() const override { return mode == Mode::TX; }
+    bool receiving() const override { return mode == Mode::RX; }
+    bool healthy() const override { return ready && mode != Mode::FAULT; }
+    uint32_t timeOnAir(size_t) override { return 1000; }  // Synthetic, never RF evidence.
+
+    RadioEvent completeTx() {
+        if (!transmitting()) { ++contractViolations; return {}; }
+        mode = Mode::IDLE;
+        RadioEvent event;
+        event.type = RadioEventType::TX_DONE;
+        return event;
+    }
+    RadioEvent deliver(const CapturedPacket& packet) {
+        if (!receiving() || !ready) { ++dropped; return {}; }
+        if (packet.length > kMaxFrameSize) { ++contractViolations; return {}; }
+        mode = Mode::IDLE;
+        RadioEvent event;
+        event.type = RadioEventType::RX_DONE;
+        event.length = packet.length;
+        std::memcpy(event.bytes, packet.bytes, packet.length);
+        return event;
+    }
+    RadioEvent error(RadioEventType type, int16_t code) {
+        mode = type == RadioEventType::ERROR ? Mode::FAULT : Mode::IDLE;
+        RadioEvent event;
+        event.type = type;
+        event.code = code;
+        return event;
+    }
+};
+}  // namespace adaptive_lora::test
diff --git a/iteration-007-review-snapshot/test/support/platform/Arduino.h b/iteration-007-review-snapshot/test/support/platform/Arduino.h
new file mode 100644
index 0000000..74161a7
--- /dev/null
+++ b/iteration-007-review-snapshot/test/support/platform/Arduino.h
@@ -0,0 +1,31 @@
+#pragma once
+#ifndef ADAPTIVE_LORA_NATIVE_TEST
+#error "Native serial adapter must never be used in firmware"
+#endif
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// Captures the real SerialLogger's output. This models byte capacity/short
+// writes only, not USB, interrupts, locks, a UART or elapsed write latency.
+class HostSerial {
+public:
+    std::string output;
+    int capacity = 64;
+    size_t writeLimit = 128;
+    size_t calls = 0;
+    size_t largestWrite = 0;
+    int availableForWrite() const { return capacity; }
+    size_t write(const uint8_t* bytes, size_t length) {
+        ++calls;
+        if (length > largestWrite) largestWrite = length;
+        size_t count = length < writeLimit ? length : writeLimit;
+        if (capacity <= 0) count = 0;
+        else if (count > static_cast<size_t>(capacity)) count = static_cast<size_t>(capacity);
+        output.append(reinterpret_cast<const char*>(bytes), count);
+        return count;
+    }
+    void reset() { output.clear(); capacity = 64; writeLimit = 128; calls = 0; largestWrite = 0; }
+};
+inline HostSerial& hostSerial() { static HostSerial serial; return serial; }
+#define Serial (hostSerial())
